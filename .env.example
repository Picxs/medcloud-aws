# ==========================================================
# Exemplo de Configuração MedCloud — Trabalho 2 (Docker & Docker Compose)
# Copie para .env: cp .env.example .env
# ==========================================================
PORT=3000
AWS_REGION=us-east-1

# --- 1. Banco de Dados Relacional (Container PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=medadmin
DB_PASSWORD=medcloud123
DB_NAME=medcloud
DB_SSL=false

# --- 2. Armazenamento de Arquivos (Container MinIO) ---
S3_BUCKET=medcloud-exames
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- 3. Fila de Mensagens (Container RabbitMQ) ---
RABBITMQ_USER=medadmin
RABBITMQ_PASS=medcloud123
RABBITMQ_URL=amqp://medadmin:medcloud123@rabbitmq:5672
RABBITMQ_QUEUE=medcloud.exames.processamento

# --- 4. Cache (Container Redis) ---
REDIS_URL=redis://redis:6379
CACHE_TTL=60

# --- 5. Banco NoSQL (AWS DynamoDB) ---
DYNAMO_TABLE=medcloud-audit
# Para rodar 100% local via Docker (sem precisar do AWS Learner Lab ligado):
DYNAMO_ENDPOINT=http://dynamodb:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Para usar o DynamoDB real na nuvem da AWS:
# 1. Comente DYNAMO_ENDPOINT acima (ou deixe DYNAMO_ENDPOINT=)
# 2. Coloque suas credenciais do AWS Learner Lab em .aws/credentials (ou nas variáveis abaixo):
# AWS_ACCESS_KEY_ID=ASIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

