# [TRABALHO 2 - DOCKERFILE FRONTEND]
# Imagem Nginx servindo a interface web estática (HTML/CSS/JS) e fazendo proxy reverso de /api para o Backend
FROM nginx:1.27-alpine

# Remove configuração padrão do Nginx e aplica configuração com proxy reverso para o container backend
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia os arquivos estáticos do frontend
COPY public /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

