# [TRABALHO 2 - DOCKERFILE WORKER]
# Imagem do Worker assíncrono que consome mensagens do RabbitMQ, processa imagens com Sharp e grava no MinIO
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install --omit=dev

COPY src ./src

ENV NODE_ENV=production

CMD ["node", "src/worker.js"]

